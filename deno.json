{
  "nodeModulesLinker": "hoisted",
  "nodeModulesDir": "manual",
  "imports": {
    "@modelcontextprotocol/sdk/server/index.js": "./node_modules/@modelcontextprotocol/sdk/dist/esm/server/index.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "./node_modules/@modelcontextprotocol/sdk/dist/esm/server/stdio.js",
    "@modelcontextprotocol/sdk/types.js": "./node_modules/@modelcontextprotocol/sdk/dist/esm/types.js"
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-run --allow-env esbuild.config.mjs",
    "dev": "deno run --allow-read --allow-write --allow-run --allow-env esbuild.config.mjs --watch",
    "test": "deno test --allow-read --allow-write --allow-env --allow-sys --allow-run",
    "check": "deno check src/"
  }
}
